{
  "name": "simpleflow.js",
  "version": "0.1.0",
  "description": "Neural network training and prediction",
  "main": "simpleflow.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "terser simpleflow.js -c -m -o simpleflow.min.js",
    "build:webgpu": "terser simpleflow.webgpu.js -c -m -o simpleflow.webgpu.min.js",
    "build:all": "npm run build && npm run build:webgpu"
  },
  "keywords": [
    "ai",
    "machine",
    "learning",
    "neural",
    "networks"
  ],
  "author": "Daniel Puckowski",
  "license": "MIT",
  "devDependencies": {
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "terser": "^5.43.1"
  }
}
